@model IndexModel

@{
    ViewData["Title"] = "Home Page";
}

<h1>@Model.Sucursal.Nombre</h1>
<h4>@Model.Sucursal.Direccion</h4>
<h4>Gerente: @Model.Sucursal.Gerente</h4>

<button onclick="abrirModal();" class="btn btn-dark">Agregar</button>

@if (TempData["mensaje"] != null)
{
    <div class="alert alert-success">
        <h4>@TempData["mensaje"]</h4>
    </div>
}

@if (TempData["error"] != null)
{
    <div class="alert alert-danger">
        <b>Ocurrio un error:</b> @TempData["error"]
    </div>
}

<table id="tblProductos" class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Descripción</th>
            <th>Precio</th>
            <th>Fecha Ingreso</th>
            <th>Fecha Caducidad</th>
            <th>¿Esta Disponible?</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody id="tbodyProductos">
    </tbody>
</table>

<div class="modal fade" tabindex="-1" id="modalFormulario">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloModal"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnIdProducto" value="0" />
                <label>Descripción</label>
                <input type="text" id="txtDescripcion" class="form-control" />
                <br />
                <label>Precio</label>
                <input type="text" id="txtPrecio" class="form-control" />
                <br />
                <label>Fecha Ingreso</label>
                <input type="date" id="txtFechaIngreso" class="form-control" />
                <br />
                <label>¿Disponible?</label>
                <div>
                    <input type="radio" name="Disponible" id="rbDisponibleSi" value="true"/>
                    <label>Si</label>

                    <input type="radio" name="Disponible" id="rbDisponibleNo" value="false" />
                    <label>No</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" onclick="guardarProducto();" class="btn btn-primary">Guardar</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link href="https://cdn.datatables.net/v/dt/dt-3.0.4/datatables.min.css" rel="stylesheet">
<script src="https://cdn.datatables.net/v/dt/dt-3.0.4/datatables.min.js"></script>
<script type="text/javascript">

    
    $(document).ready(function() {
        pintarTabla();
    });

    function pintarTabla() {
        $.ajax({
            url: '/Home/ObtenerProductos', // Ruta: /Controlador/Accion
            type: 'GET',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            success: function(respuesta) {
                var tabla = '';
                for (producto of respuesta) {
                    tabla += `
                            <tr>
                                <td>${producto.idProducto}</td>
                                <td>${producto.descripcion}</td>
                                <td>${producto.precio}</td>
                                <td>${producto.fechaIngreso}</td>
                                <td>${producto.fechaCaducidad}</td>
                                <td>${producto.disponibleTexto}</td>
                                <td>
                                    <button onclick='obtenerProductoParaEditar(${producto.idProducto})' class='btn btn-info'>Editar</button>
                                    <button onclick='confirmarBorrar(${producto.idProducto})' class='btn btn-danger'>Eliminar</button>
                                </td>
                            </tr>
                        `;
                }
                // 1. Si ya existe la tabla, la destruimos y limpiamos el HTML
                if ($.fn.DataTable.isDataTable('#tblProductos')) {
                    $('#tblProductos').DataTable().destroy();
                    $('#tbodyProductos').empty(); // Opcional: limpia el contenido viejo
                }

                // 2. Insertamos el nuevo HTML con tus filas
                $('#tbodyProductos').html(tabla);

                // 3. Volvemos a inicializar DataTables
                $('#tblProductos').DataTable();
            },
            error: function(xhr, status, error) {
                console.error("Error en la petición:", error);
            }
        });
    }

    function abrirModal() {
        //Limpiamos campos
        $('#tituloModal').html('Registrar Nuevo Producto');
        $('#txtDescripcion').val('');
        $('#txtPrecio').val('');
        $('#txtFechaIngreso').val('');
        $('#hdnIdProducto').val('0');
        //Abrimos modal
        $('#modalFormulario').modal('show');
    }

    function guardarProducto() {
        var url;
        var idProducto = parseInt($('#hdnIdProducto').val()) || 0;

        if (idProducto === 0) {
            url = '/Home/Agregar';
        } else {
            url = '/Home/Editar';
        }

        // Parsear los tipos correctamente
        var descripcion = $('#txtDescripcion').val();
        var precio = parseFloat($('#txtPrecio').val()) || 0;
        var fechaIngreso = $('#txtFechaIngreso').val(); // Ejemplo format: "2026-09-18"

        // Obtener valor del radio button y convertirlo a booleano
        var disponibleVal = $('input[name="Disponible"]:checked').val();
        var disponible = (disponibleVal === "true" || disponibleVal === "1" || disponibleVal === true);

        var producto = {
            IdProducto: idProducto,
            Descripcion: descripcion,
            Precio: precio,
            FechaIngreso: fechaIngreso,
            Disponible: disponible
        };

        $.ajax({
            url: url,
            type: 'POST',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            data: JSON.stringify(producto),
            success: function(respuesta) {
                if (respuesta.exito) {
                    pintarTabla();
                    $('#modalFormulario').modal('hide');
                    mostrarMensaje('Exito', 'Producto guardado correctamente', 'success');
                } else {
                    // Muestra los mensajes de validación devueltos por el servidor
                    mostrarMensaje('Datos incorrectos', respuesta.mensaje, 'warning');
                }
            },
            error: function(xhr, status, error) {
                console.error("Error en la petición:", error);
            }
        });
    }

    function obtenerProductoParaEditar(idProducto){
        $.ajax({
            url: '/Home/Editar?idProducto='+idProducto, // Ruta: /Controlador/Accion?parametro=valor
            type: 'GET',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            success: function(respuesta) {
                abrirModal();
                //Llenamos el formulario con los datos del producto
                $('#tituloModal').html('Editar Producto:' + respuesta.descripcion);
                $('#hdnIdProducto').val(respuesta.idProducto);
                $('#txtDescripcion').val(respuesta.descripcion);
                $('#txtPrecio').val(respuesta.precio);
                //La fecha la convertimos a formato yyyy-MM-dd
                var fechaFormateada = respuesta.fechaIngreso.split('T')[0];
                console.log(fechaFormateada);
                $('#txtFechaIngreso').val(fechaFormateada);

                if(respuesta.disponible){
                    $('#rbDisponibleSi').prop('checked', true);
                }else{
                    $('#rbDisponibleNo').prop('checked', true);
                }
            },
            error: function(xhr, status, error) {
                console.error("Error en la petición:", error);
            }
        });
    }

    function confirmarBorrar(idProducto){
        Swal.fire({
            title: "¿Estas Seguro?",
            text: "Al eliminar el producto no puede ser recuperado",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Acepto"
        }).then((result) => {
            if (result.isConfirmed) {
                borrarProducto(idProducto);
            }
        });
    }

    function borrarProducto(idProducto){
        $.ajax({
            url: '/Home/Eliminar?idProducto=' + idProducto, // Ruta: /Controlador/Accion?parametro=valor
            type: 'GET',
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            success: function(respuesta) {
                mostrarMensaje('Exito', 'Producto eliminado correctamente', 'success');
                pintarTabla();
            },
            error: function(xhr, status, error) {
                console.error("Error en la petición:", error);
            }
        });
    }

    function mostrarMensaje(titulo, mensaje, icono) {
        Swal.fire({
            title: titulo,
            html: mensaje,
            icon: icono
        });
    }
</script>
